RAILS_ENV=production
APP_HOST=sez.example.com
APP_PORT=443
FORCE_SSL=true
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2

# SMTP is optional until password reset email is enabled in production.
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DOMAIN=example.com
MAILER_FROM=no-reply@example.com

# Never commit real values.
# Prefer config/master.key + encrypted credentials and a protected database.yml.
