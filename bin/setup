#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  FileUtils.cp("config/database.example.yml", "config/database.yml") unless File.exist?("config/database.yml")

  puts "== Installing gems =="
  system!("bundle", "install") unless system("bundle", "check")

  puts "== Preparing database =="
  system!("bin/rails", "db:prepare")
  system!("bin/rails", "db:seed") if ENV["SKIP_SEEDS"] != "1"

  puts "== Building Tailwind CSS =="
  system!("bin/rails", "tailwindcss:build")

  puts "== Clearing old logs and tempfiles =="
  system!("bin/rails", "log:clear", "tmp:clear")
end
