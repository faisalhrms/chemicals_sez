<% flash.each do |type, message| %>
  <div class="page-shell pb-0" data-controller="flash">
    <div class="flex items-start justify-between gap-4 rounded-xl border px-4 py-3 text-sm <%= type.to_s == 'alert' ? 'border-red-200 bg-red-50 text-red-800' : 'border-emerald-200 bg-emerald-50 text-emerald-800' %>">
      <span><%= message %></span>
      <button type="button" data-action="flash#dismiss" class="font-bold" aria-label="Dismiss message">×</button>
    </div>
  </div>
<% end %>
