<% content_for :title, "Secure Access | Sapphire SVA SEZ" %>

<div class="auth-page">
  <div class="auth-shell">
    <section class="auth-visual">
      <%= image_tag "login-campus.webp", srcset: "#{asset_path("login-campus-small.webp")} 800w, #{asset_path("login-campus.webp")} 1600w", sizes: "(max-width: 900px) 100vw, 65vw", width: 1600, height: 1067, fetchpriority: "high", decoding: "async", alt: "", class: "auth-visual-image", aria: { hidden: true } %>
      <div class="auth-visual-overlay" aria-hidden="true"></div>

      <div class="auth-brand-row">
        <span class="auth-logo-card">
          <%= image_tag "sapphire-logo-small.png", alt: "Sapphire Chemicals", class: "h-11 w-auto" %>
        </span>
        <%= image_tag "invest-pakistan-boi.png", alt: "Invest Pakistan and BOI", class: "h-11 w-auto rounded-md bg-white/95 px-2 py-1" %>
      </div>

      <div class="auth-copy">
        <p class="auth-kicker">WELCOME TO THE</p>
        <h1>
          Sapphire Value Addition <span>(SVA)</span><br>
          Sole Enterprise Special Economic Zone <span>(SESEZ)</span>
        </h1>
        <div class="auth-section-label"><span>SEZ PORTAL</span><i></i></div>
        <p class="auth-description">The access point for zone development records, statutory approvals and project progress.</p>
        <div class="auth-meta">
          <span>SOLE ENTERPRISE SEZ</span>
          <span>SAPPHIRE CHEMICALS</span>
          <span>200 KTPA SODA ASH MANUFACTURING PLANT</span>
          <span>PRIVATE · KHUSHAB, PAKISTAN</span>
        </div>
      </div>
    </section>

    <section class="auth-form-panel">
      <div class="auth-form-card" data-controller="workspace">
        <p class="auth-form-kicker">SECURE ACCESS</p>
        <h2>Choose your workspace</h2>
        <p class="auth-form-subtitle">Sign in with your authorized Sapphire portal account.</p>

        <% if flash[:alert] %>
          <div data-controller="flash" data-action="mouseenter->flash#pause mouseleave->flash#schedule focusin->flash#pause focusout->flash#schedule" role="alert" class="mt-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"><%= flash[:alert] %></div>
        <% elsif flash[:notice] %>
          <div data-controller="flash" data-action="mouseenter->flash#pause mouseleave->flash#schedule focusin->flash#pause focusout->flash#schedule" role="status" class="mt-5 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800"><%= flash[:notice] %></div>
        <% end %>

        <%= form_with url: session_path, class: "mt-6 space-y-5" do |form| %>
          <div class="workspace-switch">
            <label>
              <%= radio_button_tag :workspace, "developer", params[:workspace] != "authority", class: "peer sr-only", data: { action: "workspace#update" } %>
              <span>Developer</span>
            </label>
            <label>
              <%= radio_button_tag :workspace, "authority", params[:workspace] == "authority", class: "peer sr-only", data: { action: "workspace#update" } %>
              <span>Authority</span>
            </label>
          </div>

          <div>
            <%= form.label :email_address, "Username or email", class: "field-label" %>
            <%= form.email_field :email_address, required: true, autocomplete: "username", autofocus: true, class: "field auth-field", placeholder: "name@sapphire.pk" %>
          </div>

          <div>
            <div class="flex items-center justify-between gap-3">
              <%= form.label :password, class: "field-label mb-0" %>
              <%= link_to "Forgot password?", new_password_path, class: "text-xs font-semibold text-blue-700 hover:underline" %>
            </div>
            <%= form.password_field :password, required: true, autocomplete: "current-password", class: "field auth-field mt-1.5" %>
          </div>

          <%= form.submit "Sign in as Developer", class: "btn-primary auth-submit w-full", data: { workspace_target: "button" } %>
        <% end %>

        <div class="auth-security-note">
          <span>ENCRYPTED SESSION</span>
          <span>AUTHORIZED USERS ONLY</span>
        </div>
        <p class="mt-5 text-xs text-slate-500">Sapphire Chemicals (Pvt.) Limited · Portal v1.0</p>
      </div>
    </section>
  </div>
</div>
