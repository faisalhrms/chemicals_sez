<% content_for :title, "Submission Records" %>
<div class="page-shell">
  <div class="mb-5">
    <h1 class="page-title">Submission Records</h1>
    <p class="page-subtitle">View all submitted reports for the selected month, latest first.</p>
  </div>

  <%= form_with url: developer_submission_records_path, method: :get, class: "card mb-5 flex items-end gap-4 p-4", data: { controller: "auto-submit" } do |form| %>
    <div class="w-full max-w-xs">
      <%= form.label :month, "Select Month", class: "field-label" %>
      <%= form.month_field :month, value: @month.strftime("%Y-%m"), class: "field", data: { action: "change->auto-submit#submit" } %>
    </div>
  <% end %>

  <div class="table-wrap" data-controller="datatable">
    <table class="data-table" data-datatable-target="table">
      <thead><tr><th>#</th><th>Report Date</th><th>Status</th><th>Submitted By</th><th>Action</th></tr></thead>
      <tbody>
        <% @reports.each_with_index do |report, index| %>
          <tr>
            <td><%= index + 1 %></td>
            <td class="font-semibold text-slate-900"><%= format_date(report.report_date) %></td>
            <td><%= render "shared/status_badge", status: report.status %></td>
            <td><%= report.submitted_by&.name || "—" %></td>
            <td><%= table_action_link "View", developer_submission_record_path(report), icon: "view" %></td>
          </tr>
        <% end %>
        <% if @reports.empty? %><tr><td colspan="5" class="text-center text-slate-500">No submissions for this month.</td></tr><% end %>
      </tbody>
    </table>
  </div>
</div>
