<% content_for :title, "Change Password" %>
<div class="page-shell account-shell">
  <div class="mb-6">
    <h1 class="page-title">Security</h1>
    <p class="page-subtitle">Change your password securely.</p>
  </div>

  <%= render "shared/account_tabs" %>

  <section class="card mt-5 max-w-2xl p-5 sm:p-6">
    <h2 class="text-base font-bold text-slate-900">Change password</h2>
    <p class="mt-1 text-sm text-slate-500">Enter your current password before choosing a new one.</p>

    <%= form_with url: account_password_path, method: :patch, class: "mt-6 space-y-5" do |form| %>
      <div>
        <%= form.label :current_password, "Current password", class: "field-label" %>
        <%= form.password_field :current_password, required: true, class: "field", autocomplete: "current-password" %>
      </div>
      <div>
        <%= form.label :password, "New password", class: "field-label" %>
        <%= form.password_field :password, required: true, minlength: 12, class: "field", autocomplete: "new-password" %>
        <p class="mt-1 text-xs text-slate-400">Use at least 12 characters.</p>
      </div>
      <div>
        <%= form.label :password_confirmation, "Confirm new password", class: "field-label" %>
        <%= form.password_field :password_confirmation, required: true, minlength: 12, class: "field", autocomplete: "new-password" %>
      </div>
      <div class="form-actions">
        <span class="save-hint">Changing your password signs out your other active sessions.</span>
        <%= form.submit "Change Password", class: "btn-primary" %>
      </div>
    <% end %>
  </section>
</div>
