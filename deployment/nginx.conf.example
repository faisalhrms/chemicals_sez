limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=10r/m;

upstream sapphire_sez_puma {
    server 127.0.0.1:3000;
    keepalive 16;
}

server {
    listen 80;
    server_name sez.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name sez.example.com;

    ssl_certificate     /etc/letsencrypt/live/sez.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sez.example.com/privkey.pem;

    client_max_body_size 12m;

    root /var/www/sapphire_sez_portal/current/public;

    location = /session {
        limit_req zone=auth_limit burst=5 nodelay;
        proxy_pass http://sapphire_sez_puma;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /forgot-password {
        limit_req zone=auth_limit burst=3 nodelay;
        proxy_pass http://sapphire_sez_puma;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        proxy_pass http://sapphire_sez_puma;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-Start "t=${msec}";
        proxy_read_timeout 60s;
    }
}
